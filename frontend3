class EbBusApp extends StatelessWidget {
  const EbBusApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'ebBus',
      theme: ThemeData(
        colorScheme: ColorScheme.fromSeed(seedColor: const Color(0xFF0C203B)),
        useMaterial3: true,
      ),
      home: const MainScreen(),
    );
