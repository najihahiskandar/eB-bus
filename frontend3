class AlertsScreen extends StatelessWidget {
  final List<String> alerts;

  const AlertsScreen({super.key, required this.alerts});

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      body: alerts.isEmpty
          ? const Center(child: Text('No alerts yet.'))
          : Column(
              children: [
                // Show the latest alert at the top with a blue box
                if (alerts.isNotEmpty)
                  Container(
                    padding: const EdgeInsets.all(16.0),
                    margin: const EdgeInsets.all(8.0),
                    decoration: BoxDecoration(
                      color: const Color(0xFF0C203B),
                      borderRadius: BorderRadius.circular(12),
                    ),
                    child: Row(
                      children: [
                        const Icon(Icons.warning, color: Colors.white),
                        const SizedBox(width: 8),
                        Expanded(
                          child: Text(
                            alerts.last, // Newest alert at the top
                            style: const TextStyle(
                                color: Colors.white, fontSize: 16),
                          ),
                        ),
                      ],
                    ),
                  ),
                // Show the previous alerts below the blue box
                Expanded(
                  child: ListView.builder(
                    itemCount: alerts.length - 1, // Exclude the latest alert
                    itemBuilder: (context, index) {
                      return ListTile(
                        leading: const Icon(Icons.warning, color: Colors.red),
                        title: Text(alerts[index]),
                      );
                    },
                  ),
                ),
              ],
            ),
    );
  }
}




